# Environment Variables

# App Settings
APP_ENV=development
APP_DEBUG=true
PORT=8081

# Database
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/houseproject_db?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Langchain / LangGraph compatible)
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (Recommended for coding/structured output)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Other Providers (Aliyun, Zhipu, etc.)
# ALIYUN_API_KEY=your_aliyun_api_key_here

# Image Generation / Multi-modal API Keys
# SD_API_URL=http://localhost:7860
# SD_API_KEY=your_sd_api_key_here

# Object Storage (OSS/COS)
OSS_ACCESS_KEY_ID=your_oss_access_key
OSS_SECRET_ACCESS_KEY=your_oss_secret_key
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=your_oss_endpoint
