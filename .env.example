# ============================================================
# 应用运行
# ============================================================
APP_ENV=development
APP_DEBUG=true
PORT=8000

# ============================================================
# 数据库
# ============================================================
DATABASE_URL=mysql+pymysql://root:change_me@127.0.0.1:3306/houseproject_db?charset=utf8mb4

# ============================================================
# 文本模型（OpenAI 兼容 API）
# 用于需求解析、对话、方案生成、画像提取和 Scene Agent
# ============================================================
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3

# ============================================================
# 视觉模型（OpenAI 兼容 API）
# VL_REASONING_MODEL 已预留，当前业务仍使用 VL_MODEL
# ============================================================
VL_API_KEY=your_vl_api_key_here
VL_BASE_URL=https://api.siliconflow.cn/v1
VL_MODEL=Qwen/Qwen3-VL-32B-Instruct
VL_REASONING_MODEL=Qwen/Qwen3-VL-32B-Thinking

# ============================================================
# 本地效果图模型（Stable Diffusion 1.5 + ControlNet MLSD）
# ============================================================
SD_ENABLED=true
SD_BASE_MODEL=Lykon/dreamshaper-8
SD_CONTROLNET_MODEL=lllyasviel/control_v11p_sd15_mlsd
HF_HOME=./hf_cache

# ============================================================
# 登录与短信
# 生产环境必须替换 JWT_SECRET_KEY，并接入真实短信服务商
# ============================================================
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
SMS_MOCK_CODE=123456
SMS_CODE_EXPIRE_SECONDS=300
SMS_CODE_RESEND_SECONDS=60

# ============================================================
# 上传与 Scene Agent
# ============================================================
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_IMAGE_MB=10
MAX_UPLOAD_MODEL_MB=25
SCENE_AGENT_REQUESTS_PER_MINUTE=6

# ============================================================
# Blender Worker
# ============================================================
BLENDER_EXECUTABLE=blender
BLENDER_WORK_DIR=backend/worker_data/blender
FRONTEND_PUBLIC_DIR=frontend/public
BLENDER_RENDER_TIMEOUT_SECONDS=1200
BLENDER_RENDER_MAX_MB=30
BLENDER_WORKER_POLL_SECONDS=2
BLENDER_WORKER_MAX_ATTEMPTS=2
BLENDER_RENDER_REQUESTS_PER_HOUR=10
BLENDER_ALLOW_UPLOADED_MODELS=false

# ============================================================
# 店铺初始信息（首次写库后以后台配置为准）
# ============================================================
SHOP_NAME=AI 家装定制助手
SHOP_PHONE=
SHOP_WECHAT=
SHOP_ADDRESS=
SHOP_SLOGAN=让 AI 为你定制理想中的家
