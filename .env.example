# Environment Variables

# App Settings
APP_ENV=development
APP_DEBUG=true
PORT=8081

# Database
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/houseproject_db?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Langchain / LangGraph compatible)
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (Recommended for coding/structured output)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen-VL（图片与户型分析）
VL_API_KEY=your_vl_api_key_here
VL_API_KEY_BASE_URL=https://api.siliconflow.cn/v1
VL_MODEL1=Qwen/Qwen3-VL-32B-Instruct
VL_MODEL2=Qwen/Qwen3-VL-32B-Thinking

# Other Providers (Aliyun, Zhipu, etc.)
# ALIYUN_API_KEY=your_aliyun_api_key_here

# Image Generation / Multi-modal API Keys
# SD_API_URL=http://localhost:7860
# SD_API_KEY=your_sd_api_key_here
SD_ENABLED=true
SD_BASE_MODEL=Lykon/dreamshaper-8
SD_CONTROLNET_MODEL=lllyasviel/control_v11p_sd15_mlsd
HF_HOME=D:/hf_cache

# 上传限制
MAX_UPLOAD_IMAGE_MB=10

# 店铺默认信息（首次写入数据库后以后台配置为准）
SHOP_NAME=AI 家装定制助手
SHOP_PHONE=
SHOP_WECHAT=
SHOP_ADDRESS=
SHOP_SLOGAN=让 AI 为你定制理想中的家

# Object Storage (OSS/COS)
OSS_ACCESS_KEY_ID=your_oss_access_key
OSS_SECRET_ACCESS_KEY=your_oss_secret_key
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=your_oss_endpoint
