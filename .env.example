# ============================================================
# 应用运行
# ============================================================
APP_ENV=development
APP_DEBUG=true
PORT=8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ============================================================
# 数据库
# ============================================================
DATABASE_URL=mysql+pymysql://root:change_me@127.0.0.1:3306/houseproject_db?charset=utf8mb4

# ============================================================
# 文本模型（OpenAI 兼容 API）
# 用于需求解析、对话、方案生成、画像提取和 Scene Agent
# ============================================================
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3

# ============================================================
# 视觉模型（OpenAI 兼容 API）
# VL_REASONING_MODEL 已预留，当前业务仍使用 VL_MODEL
# ============================================================
VL_API_KEY=your_vl_api_key_here
VL_BASE_URL=https://api.siliconflow.cn/v1
VL_MODEL=Qwen/Qwen3-VL-32B-Instruct
VL_REASONING_MODEL=Qwen/Qwen3-VL-32B-Thinking

# ============================================================
# 本地效果图模型（Stable Diffusion 1.5 + ControlNet MLSD）
# ============================================================
SD_ENABLED=true
SD_BASE_MODEL=Lykon/dreamshaper-8
SD_CONTROLNET_MODEL=lllyasviel/control_v11p_sd15_mlsd
HF_HOME=./hf_cache

# ============================================================
# 登录与短信
# 生产环境必须替换 JWT_SECRET_KEY，并接入真实短信服务商
# ============================================================
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=haus_session
SMS_MOCK_CODE=123456
SMS_CODE_EXPIRE_SECONDS=300
SMS_CODE_RESEND_SECONDS=60

# ============================================================
# 上传与 Scene Agent
# ============================================================
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_IMAGE_MB=10
MAX_UPLOAD_MODEL_MB=25
PDF_FONT_REGULAR_PATH=
PDF_FONT_BOLD_PATH=
SCENE_AGENT_REQUESTS_PER_MINUTE=6
DEMO_AGENT_REQUESTS_PER_MINUTE=6
DEMO_AGENT_IP_REQUESTS_PER_MINUTE=20

# ============================================================
# Blender Worker
# ============================================================
BLENDER_EXECUTABLE=blender
BLENDER_WORK_DIR=backend/worker_data/blender
FRONTEND_PUBLIC_DIR=frontend/public
BLENDER_RENDER_TIMEOUT_SECONDS=1200
BLENDER_RENDER_MAX_MB=30
BLENDER_WORKER_POLL_SECONDS=2
BLENDER_WORKER_MAX_ATTEMPTS=2
BLENDER_RENDER_REQUESTS_PER_HOUR=10
BLENDER_ALLOW_UPLOADED_MODELS=false

# ============================================================
# 方案生成 Worker
# API 默认只入队；生产环境必须独立启动 Worker
# ============================================================
# 同一任务的同步 Agent turn 最长占用时间；过期后停止旧执行并转人工
DESIGN_AGENT_TURN_LEASE_SECONDS=300
GENERATION_WORKER_POLL_SECONDS=1
GENERATION_WORKER_MAX_ATTEMPTS=3
GENERATION_WORKER_LEASE_SECONDS=180
GENERATION_WORKER_HEARTBEAT_SECONDS=15
GENERATION_WORKER_RETRY_BASE_SECONDS=5
# 仅供本地调试，生产环境禁止开启
GENERATION_INLINE_FALLBACK=false

# ============================================================
# 真实案例评测与独立跨用户 HTTP 安全证据
# 两组 key 必须来自不同密钥域，禁止提交真实值
# APP_BUILD_DIGEST 由发布流水线注入当前应用制品 SHA-256
# ============================================================
EVAL_EVIDENCE_KEY_ID=
EVAL_EVIDENCE_HMAC_KEY=
SECURITY_EVIDENCE_KEY_ID=
SECURITY_EVIDENCE_HMAC_KEY=
APP_BUILD_DIGEST=

# ============================================================
# 效果图 Worker
# API 只入队；SD/ControlNet 仅在独立 Worker 内执行
# ============================================================
EFFECT_RENDER_WORKER_POLL_SECONDS=1
EFFECT_RENDER_WORKER_MAX_ATTEMPTS=2
EFFECT_RENDER_WORKER_LEASE_SECONDS=180
EFFECT_RENDER_WORKER_HEARTBEAT_SECONDS=15
EFFECT_RENDER_WORKER_EXECUTION_TIMEOUT_SECONDS=900
EFFECT_RENDER_WORKER_RETRY_BASE_SECONDS=5

# ============================================================
# 店铺初始信息（首次写库后以后台配置为准）
# ============================================================
SHOP_NAME=AI 家装定制助手
SHOP_PHONE=
SHOP_WECHAT=
SHOP_ADDRESS=
SHOP_SLOGAN=让 AI 为你定制理想中的家
