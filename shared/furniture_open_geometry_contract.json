{
  "schema_version": "furniture-open-geometry/1.0",
  "coordinate_system": {"unit": "mm", "up_axis": "Y", "forward_axis": "+Z", "origin": "floor_center"},
  "operation_types": ["create", "patch", "unsupported"],
  "geometry_types": ["box", "cylinder", "sphere", "sweep", "lathe"],
  "transform_support": {"translation": true, "rotation": false, "parent_translation": true, "design_scale": true},
  "limits": {
    "max_parts": 32,
    "max_materials": 12,
    "max_control_points": 24,
    "max_total_control_points": 160,
    "max_coordinate_mm": 5000,
    "max_extent_mm": 6000,
    "max_history_versions": 20,
    "min_dimension_mm": 1,
    "min_geometry_length_mm": 0.1,
    "max_segments": 96
  },
  "patch_contract": {
    "stable_part_ids": true,
    "upsert_is_full_part": true,
    "remove_requires_existing_id": true,
    "unchanged_fields_are_preserved": true
  }
}
